rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == "logistica118ferrara@gmail.com" || 
        request.auth.token.email == "marchesoft1@gmail.com"
      );
    }
  }
}
